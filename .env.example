# Supabase project settings — see README.md for where to find these.

# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER expose this to the browser.
# Used by API routes to write data after checking the host token.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: an extra secret mixed into the host token hash. If unset, a
# hardcoded dev default is used (fine for local dev, set a real value for
# any deployed environment).
HOST_TOKEN_PEPPER=

# Optional: secret checked against the Authorization header on the daily
# cleanup cron endpoint (see vercel.json), so it can't be triggered by
# anyone else. If unset, the check is skipped — fine for local dev, set a
# real value for any deployed environment.
CRON_SECRET=

# Optional: days after creation an event (and its photos) is auto-deleted.
# Defaults to 30 if unset.
EVENT_RETENTION_DAYS=

# Optional: same number as EVENT_RETENTION_DAYS, duplicated with the
# NEXT_PUBLIC_ prefix so the app can display an accurate "deleted on <date>"
# notice to users without a server round trip. Keep both in sync — this one
# is display-only and isn't used for the actual deletion.
NEXT_PUBLIC_EVENT_RETENTION_DAYS=
